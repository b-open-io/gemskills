    },
    "binding:a_start_ing_s": { "id": "binding:a_start_ing_s", "typeName": "binding", "type": "arrow", "fromId": "shape:a_start_ing", "toId": "shape:start", "props": { "terminal": "start", "normalizedAnchor": { "x": 0.5, "y": 0.5 }, "isExact": false, "isPrecise": false, "snap": "none" }, "meta": {} },
    "binding:a_start_ing_e": { "id": "binding:a_start_ing_e", "typeName": "binding", "type": "arrow", "fromId": "shape:a_start_ing", "toId": "shape:ingestion", "props": { "terminal": "end", "normalizedAnchor": { "x": 0.5, "y": 0.5 }, "isExact": false, "isPrecise": false, "snap": "none" }, "meta": {} },

