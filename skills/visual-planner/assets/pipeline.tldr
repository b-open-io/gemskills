{
  "store": {
    "document:document": {
      "gridSize": 10,
      "name": "Linear Pipeline",
      "meta": { "description": "Sequential pipeline: ingest, process, validate, deliver. Ideal for ETL, CI/CD, or any linear process." },
      "id": "document:document",
      "typeName": "document"
    },
    "page:page": {
      "meta": {},
      "id": "page:page",
      "name": "Page 1",
      "index": "a1",
      "typeName": "page"
    },

    "shape:start": {
      "id": "shape:start", "typeName": "shape", "type": "geo",
      "x": 300, "y": 0, "rotation": 0, "index": "a1",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "ellipse", "w": 60, "h": 60,
        "color": "green", "fill": "solid", "dash": "solid",
        "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Start" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": { "nodeType": "start", "phase": "planned" }
    },

    "shape:ingestion": {
      "id": "shape:ingestion", "typeName": "shape", "type": "geo",
      "x": 230, "y": 120, "rotation": 0, "index": "a2",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "cloud", "w": 200, "h": 100,
        "color": "light-blue", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Data Ingestion" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "tool", "phase": "planned",
        "tools": ["fetch-api", "read-csv", "stream-events"],
        "description": "Pull data from sources, normalize into common schema."
      }
    },

    "shape:processing": {
      "id": "shape:processing", "typeName": "shape", "type": "geo",
      "x": 230, "y": 280, "rotation": 0, "index": "a3",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "rectangle", "w": 200, "h": 80,
        "color": "grey", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Processor" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "worker", "phase": "planned",
        "agent": "Maxim", "model": "sonnet",
        "tools": ["transform-data", "deduplicate", "enrich"],
        "description": "Clean, deduplicate, and enrich ingested data."
      }
    },

    "shape:validation": {
      "id": "shape:validation", "typeName": "shape", "type": "geo",
      "x": 230, "y": 430, "rotation": 0, "index": "a4",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "diamond", "w": 200, "h": 120,
        "color": "yellow", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Validate" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "human_checkpoint", "phase": "planned",
        "description": "Quality gate. Human spot-checks processed records."
      }
    },

    "shape:output": {
      "id": "shape:output", "typeName": "shape", "type": "geo",
      "x": 230, "y": 610, "rotation": 0, "index": "a5",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "cloud", "w": 200, "h": 100,
        "color": "light-blue", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Output Delivery" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "tool", "phase": "planned",
        "tools": ["write-database", "push-api", "generate-report"],
        "description": "Deliver validated data to destinations."
      }
    },

    "shape:end": {
      "id": "shape:end", "typeName": "shape", "type": "geo",
      "x": 300, "y": 770, "rotation": 0, "index": "a6",
