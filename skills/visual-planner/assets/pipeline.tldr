      "x": 330, "y": 60, "rotation": 0, "index": "b1",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "kind": "elbow", "color": "black", "fill": "none", "dash": "solid",
        "size": "m", "font": "sans", "labelColor": "black",
        "arrowheadStart": "none", "arrowheadEnd": "triangle",
        "start": { "x": 0, "y": 0 }, "end": { "x": 0, "y": 60 },
        "bend": 0, "labelPosition": 0.5, "scale": 1, "elbowMidPoint": 0.5,
        "richText": { "type": "doc", "content": [{ "type": "paragraph" }] }
