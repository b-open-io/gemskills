        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Web Searcher" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "worker", "phase": "implemented",
        "tools": ["web-search", "scrape-url"],
        "description": "Performs web searches, extracts page content."
      }
    },

    "shape:data_analyst": {
      "id": "shape:data_analyst", "typeName": "shape", "type": "geo",
      "x": 250, "y": 200, "rotation": 0, "index": "a6",
