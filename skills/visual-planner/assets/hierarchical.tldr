      "meta": {
        "nodeType": "worker", "phase": "planned",
        "tools": ["query-database", "run-analysis", "generate-chart"],
        "description": "Queries internal data, produces statistical summaries."
      }
    },

    "shape:fact_checker": {
      "id": "shape:fact_checker", "typeName": "shape", "type": "geo",
      "x": 150, "y": 300, "rotation": 0, "index": "a7",
      "parentId": "shape:research_frame", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "rectangle", "w": 180, "h": 70,
        "color": "grey", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fact Checker" }] }] },
