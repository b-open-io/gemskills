        "tools": ["assign-section", "review-draft", "merge-document"],
        "description": "Manages content sub-team. Assigns sections, reviews, merges."
      }
    },

    "shape:tech_writer": {
      "id": "shape:tech_writer", "typeName": "shape", "type": "geo",
      "x": 20, "y": 200, "rotation": 0, "index": "aA",
