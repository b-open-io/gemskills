{
  "store": {
    "document:document": {
      "gridSize": 10,
      "name": "Hierarchical Teams",
      "meta": { "description": "Top-level supervisor delegates to Research and Content sub-teams, each with their own supervisor and workers." },
      "id": "document:document",
      "typeName": "document"
    },
    "page:page": {
      "meta": {},
      "id": "page:page",
      "name": "Page 1",
      "index": "a1",
      "typeName": "page"
    },

    "shape:start": {
      "id": "shape:start", "typeName": "shape", "type": "geo",
      "x": 470, "y": 0, "rotation": 0, "index": "a1",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "ellipse", "w": 60, "h": 60,
        "color": "green", "fill": "solid", "dash": "solid",
        "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Start" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": { "nodeType": "start", "phase": "implemented" }
    },

    "shape:top_sup": {
      "id": "shape:top_sup", "typeName": "shape", "type": "geo",
      "x": 380, "y": 120, "rotation": 0, "index": "a2",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "rectangle", "w": 240, "h": 80,
        "color": "violet", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Top Supervisor" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "supervisor", "phase": "in_progress",
        "agent": "Sage", "model": "opus",
        "tools": ["dispatch-team", "merge-results", "status-check"],
        "description": "Decomposes requests, dispatches to sub-teams, merges results."
      }
    },

    "shape:research_frame": {
      "id": "shape:research_frame", "typeName": "shape", "type": "frame",
      "x": 0, "y": 280, "rotation": 0, "index": "a3",
      "parentId": "page:page", "isLocked": false, "opacity": 1,
      "props": { "w": 480, "h": 380, "name": "Research Team", "color": "blue" },
      "meta": {}
    },

    "shape:research_sup": {
      "id": "shape:research_sup", "typeName": "shape", "type": "geo",
      "x": 130, "y": 40, "rotation": 0, "index": "a4",
      "parentId": "shape:research_frame", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "rectangle", "w": 220, "h": 80,
        "color": "violet", "fill": "solid", "dash": "solid",
        "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle",
        "labelColor": "black",
        "richText": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Research Lead" }] }] },
        "url": "", "growY": 0, "scale": 1
      },
      "meta": {
        "nodeType": "supervisor", "phase": "in_progress",
        "agent": "Parker", "model": "sonnet",
        "tools": ["assign-query", "evaluate-sources", "compile-brief"],
        "description": "Manages research sub-team. Splits queries, compiles briefs."
      }
    },

    "shape:web_searcher": {
      "id": "shape:web_searcher", "typeName": "shape", "type": "geo",
      "x": 20, "y": 200, "rotation": 0, "index": "a5",
      "parentId": "shape:research_frame", "isLocked": false, "opacity": 1,
      "props": {
        "geo": "rectangle", "w": 180, "h": 70,
        "color": "green", "fill": "solid", "dash": "solid",
